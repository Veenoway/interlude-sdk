{
  "name": "@interludelayer-sdk/cli",
  "version": "0.2.2",
  "description": "Generate, check and ship a Delegatable contract to a hosted Interlude node on Monad testnet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veenoway/interlude-sdk.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/Veenoway/interlude-sdk#readme",
  "bugs": "https://github.com/Veenoway/interlude-sdk/issues",
  "keywords": [
    "monad",
    "ethereum",
    "evm",
    "rollup",
    "ephemeral-rollup",
    "foundry",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "interlude": "./dist/index.js"
  },
  "files": [
    "dist",
    "artifacts",
    "contracts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bundle": "node scripts/bundle-artifacts.mjs && node scripts/bundle-contracts.mjs",
    "build": "tsup",
    "prepublishOnly": "pnpm bundle && pnpm build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "smol-toml": "^1.3.1",
    "viem": "^2.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
