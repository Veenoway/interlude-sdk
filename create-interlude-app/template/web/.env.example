# Written for you, so you rarely edit this by hand:
#   hosted:  cd ../contracts && npx @interludelayer-sdk/cli ship --owner <you> --out ../web/.env.local
#   local:   cd ../contracts && npm run dev   (writes ../web/.env.local from interlude.toml [env])
# To fill them in yourself, copy this file to .env.local. All three are public: Next.js inlines
# NEXT_PUBLIC_* into the page at build time, so restart `npm run dev` after changing them.

# The Clicker contract on the base chain: what ship printed as "app". e.g. 0x1234...abcd
NEXT_PUBLIC_INTERLUDE_APP=

# The node serving it: what ship printed as "node". e.g. https://il-0123456789abcdef.fly.dev
# A 502 there for the first few minutes after ship is the node's machine starting.
NEXT_PUBLIC_INTERLUDE_NODE=

# The base chain, where sessions are anchored and commits settle. Empty means Monad testnet.
NEXT_PUBLIC_INTERLUDE_BASE_RPC=https://testnet-rpc.monad.xyz
